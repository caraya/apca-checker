{
  "name": "vite-react-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:5174": "vite --port 5174 --strictPort",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test:unit": "playwright test --config=playwright.unit.config.js",
    "test:e2e:run": "wait-on -t 120000 tcp:localhost:5174 && playwright test --config=playwright.e2e.config.js",
    "test:a11y:run": "wait-on -t 120000 tcp:localhost:5174 && playwright test --config=playwright.e2e.config.js tests/e2e/accessibility.spec.js --reporter=line",
    "test:a11y:report": "wait-on -t 120000 tcp:localhost:5174 && playwright test --config=playwright.e2e.config.js tests/e2e/accessibility.spec.js --reporter=list,html",
    "test:install-browsers": "playwright install"
  },
  "dependencies": {
    "colorjs.io": "^0.4.5",
    "opentype.js": "^1.3.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.14",
    "eslint": "^8.45.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "postcss": "^8.4.27",
    "tailwindcss": "^3.3.3",
    "vite": "^7.0.0",
    "wait-on": "^8.0.5"
  }
}
